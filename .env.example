# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Postgres Database URL
DATABASE_URL=postgresql://user:password@localhost:5432/ecommerce?schema=public

# Admin Seeder
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=secure-admin-password

# JWT Secrets
JWT_SECRET=super-secret-jwt-key-change-in-prod
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=super-secure-cookie-secret-key-for-session-signing

# Allowed Origins (CORS)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Google Analytics 4 tracking (frontend/backend)
GA_MEASUREMENT_ID=G-XXXXXXXXXX
GA_API_SECRET=your-ga-api-secret

# Google Analytics Data API (backend)
GA_PROPERTY_ID=your-ga-property-id
GOOGLE_CREDENTIALS_JSON='{"type":"service_account",...}'
