  quantity Int @default(0)
  lowStock Int @default(10)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([warehouseId, variantId])
  @@index([productId])
  @@index([variantId])
  @@index([warehouseId])
}

// ------------------------------------------------------
// ORDERS & ACTIVITY (Existing)
// ------------------------------------------------------

model Order {
  id                       String                  @id @default(uuid())
  orderNumber              String                  @unique
  customerId               String
  customer                 Customer                @relation(fields: [customerId], references: [id])
  status                   String                  @default("Pending")
  paymentStatus            String                  @default("Unpaid")
  totalAmount              Decimal
  shippingAddress          String?
  billingAddress           String?
  paymentMethod            String?
  assignedStaffId          String?
  assignedStaff            User?                   @relation("AssignedOrders", fields: [assignedStaffId], references: [id])
  internalNotes            String?
  couponId                 String?
  coupon                   Coupon?                 @relation(fields: [couponId], references: [id])
  items                    OrderItem[]
  timeline                 OrderTimeline[]
  shipments                Shipment[]
  returnRequests           ReturnRequest[]
  notifications            Notification[]
  notificationPref         NotificationPreference? @relation(fields: [notificationPreferenceId], references: [id])
  activities               CustomerActivity[]
  analyticsEvents          AnalyticsEvent[]
  abandonedCarts           AbandonedCart[]
  orderNotes               OrderNote[]
  payments                 Payment[]
  refunds                  Refund[]
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  deletedAt                DateTime?
  notificationPreferenceId String?

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@index([assignedStaffId])
  @@index([couponId])
}

model OrderItem {
  id               String          @id @default(uuid())
  orderId          String
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product         @relation(fields: [productId], references: [id])
  productVariantId String?
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
  shipmentItems    ShipmentItem[]
  returnItems      ReturnItem[]
  quantity         Int
  price            Decimal
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([orderId])
  @@index([productId])
  @@index([productVariantId])
}

model OrderTimeline {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  action    String
  userId    String?
  userName  String?
  createdAt DateTime @default(now())
  @@index([orderId])
}

model OrderNote {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  note      String
  author    String?
  createdAt DateTime @default(now())
}

model Coupon {
  id                   String    @id @default(uuid())
  code                 String    @unique
  discountType         String // "fixed", "percentage", "free_shipping"
  discountValue        Decimal
  validFrom            DateTime
  validUntil           DateTime
  isActive             Boolean   @default(true)
  minOrderAmount       Decimal?
  maxDiscountAmount    Decimal?
  usageLimit           Int?
  usagePerCustomer     Int?
  usedCount            Int       @default(0)
  applicableCategories String? // JSON array of category IDs
  applicableProducts   String? // JSON array of product IDs
  applicableBrands     String? // JSON array of brand IDs
  orders               Order[]
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  @@index([validFrom])
  @@index([validUntil])
  @@index([isActive])
}

model Promotion {
  id            String    @id @default(uuid())
  name          String
  type          String // "buy_x_get_y", "category_discount", "brand_discount", "cart_discount", "bundle_discount"
  discountType  String? // "percentage", "fixed"
  discountValue Decimal?
  rules         String? // JSON configuration for conditions (e.g. buyQty, getQty, categoryIds, brandIds, minAmount)
  priority      Int       @default(0)
  isStackable   Boolean   @default(false)
  startDate     DateTime?
  endDate       DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  @@index([startDate])
  @@index([endDate])
  @@index([isActive])
}

model MarketingCampaign {
  id          String    @id @default(uuid())
  name        String
  type        String // "Email", "SMS", "Push"
  subject     String?
  content     String
  status      String    @default("Draft") // "Draft", "Scheduled", "Sent", "Archived"
  scheduledAt DateTime?
  sentAt      DateTime?
  metrics     String? // JSON object e.g. { "openRate": "24%", "clickRate": "8%", "conversions": 14, "revenue": 1250 }
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
}

model Banner {
  id           String    @id @default(uuid())
  title        String
  desktopImage String
  mobileImage  String?
  linkUrl      String?
  ctaText      String?
  startDate    DateTime?
  endDate      DateTime?
  priority     Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
}

model Popup {
  id           String    @id @default(uuid())
  title        String
  type         String    @default("homepage") // "exit_intent", "homepage", "product", "coupon"
  headline     String?
  body         String?
  couponCode   String?
  imageUrl     String?
  delaySeconds Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
}

model Review {
  id         String    @id @default(uuid())
  productId  String
  product    Product   @relation(fields: [productId], references: [id])
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id])
  rating     Int       @default(5)
  comment    String?
  isApproved Boolean   @default(false)
